{
  "testPlan": {
    "id": "darckmaker-frontend-tests",
    "title": "Darckmaker Web Frontend Tests",
    "description": "Comprehensive frontend testing for portfolio website",
    "steps": [
      {
        "id": "home_page_basic",
        "name": "Home Page - Basic Functionality",
        "description": "Test home page loads correctly with all elements",
        "path": "/",
        "assertions": [
          "Page loads without errors",
          "Navigation bar is visible",
          "Hero section displays",
          "Theme toggle button works",
          "Footer is present",
          "Animated pets are visible"
        ]
      },
      {
        "id": "theme_toggle",
        "name": "Theme Toggle Functionality",
        "description": "Test dark/light mode switching",
        "path": "/",
        "assertions": [
          "Theme toggle button is visible",
          "Clicking toggle switches theme",
          "Theme persists across pages",
          "Colors change correctly in both modes"
        ]
      },
      {
        "id": "navigation",
        "name": "Navigation Testing",
        "description": "Test all navigation links work",
        "path": "/",
        "assertions": [
          "Home link works",
          "Works link works",
          "Navigation is responsive",
          "Links are accessible"
        ]
      },
      {
        "id": "works_page",
        "name": "Works Page Testing",
        "description": "Test works listing page",
        "path": "/works",
        "assertions": [
          "Page loads successfully",
          "Work items are displayed",
          "Links to individual works work",
          "Back navigation works"
        ]
      },
      {
        "id": "blog_functionality",
        "name": "Blog Functionality",
        "description": "Test blog listing and post pages",
        "path": "/posts",
        "assertions": [
          "Blog listing loads",
          "Post cards display correctly",
          "Individual post pages work",
          "Markdown content renders properly"
        ]
      },
      {
        "id": "responsive_design",
        "name": "Responsive Design",
        "description": "Test responsive behavior",
        "path": "/",
        "assertions": [
          "Mobile view works correctly",
          "Tablet view adapts properly",
          "Desktop layout is correct",
          "Navigation is mobile-friendly"
        ]
      },
      {
        "id": "page_transitions",
        "name": "Page Transitions",
        "description": "Test smooth page transitions",
        "path": "/",
        "assertions": [
          "Page transitions are smooth",
          "Animations work correctly",
          "No jarring jumps between pages",
          "Loading states are handled"
        ]
      },
      {
        "id": "error_handling",
        "name": "Error Handling",
        "description": "Test 404 page and error states",
        "path": "/non-existent-page",
        "assertions": [
          "404 page displays correctly",
          "Error page is user-friendly",
          "Navigation from error page works",
          "No console errors"
        ]
      }
    ]
  }
}
